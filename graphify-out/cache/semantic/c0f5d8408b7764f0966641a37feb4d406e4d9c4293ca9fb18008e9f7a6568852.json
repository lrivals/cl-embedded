core": 1.0, "source_file": "docs/context/ram_measurement.md", "source_location": null, "weight": 1.0}, {"source": "context_ram_measurement_shared_frame_thesis", "target": "context_ram_measurement_ram_peak", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/context/ram_measurement.md", "source_location": null, "weight": 1.0}, {"source": "context_ram_measurement_ram_peak", "target": "claude_gap_2", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/context/ram_measurement.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "ram_measurement_protocol", "label": "Protocole de mesure RAM (contigu\u00eft\u00e9 .bss + stack painting + borne statique)", "nodes": ["src_profiling", "startup_startup_stm32f439xx", "linker_stm32f439zitx_flash", "scripts_measure_stack_watermark", "scripts_stack_usage_report", "context_ram_measurement_ram_peak"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/context/ram_measurement.md"}]}